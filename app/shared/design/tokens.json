{
  "n0": {
    "color": {
      "ink": { "$type": "color", "$value": "#18120e" },
      "inkSoft": { "$type": "color", "$value": "#42342b" },
      "paper": { "$type": "color", "$value": "#f6efe3" },
      "paperAlt": { "$type": "color", "$value": "#efe4d1" },
      "cream": { "$type": "color", "$value": "#fffaf3" },
      "mist": { "$type": "color", "$value": "#faf5ed" },
      "warm": { "$type": "color", "$value": "#8f2f1c" },
      "warmAlt": { "$type": "color", "$value": "#c95e2a" },
      "cacao": { "$type": "color", "$value": "#241913" },
      "sand": { "$type": "color", "$value": "#ddc2a1" },
      "line": { "$type": "color", "$value": "rgba(38, 26, 18, 0.12)" },
      "whiteGlass": { "$type": "color", "$value": "rgba(255,255,255,0.82)" },
      "whiteGlassStrong": { "$type": "color", "$value": "rgba(255,255,255,0.9)" }
    },
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "Fraunces, ui-serif, Georgia, Cambria, \"Times New Roman\", serif"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
      },
      "editorial": {
        "$type": "fontFamily",
        "$value": "Spectral, ui-serif, Georgia, Cambria, \"Times New Roman\", serif"
      }
    },
    "shadow": {
      "soft": { "$type": "shadow", "$value": "0 12px 40px rgba(62, 41, 22, 0.08)" },
      "deep": { "$type": "shadow", "$value": "0 18px 60px rgba(34, 23, 16, 0.18)" },
      "lift": { "$type": "shadow", "$value": "0 24px 80px rgba(24, 18, 14, 0.12)" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": 14 },
      "md": { "$type": "dimension", "$value": 20 },
      "lg": { "$type": "dimension", "$value": 28 },
      "xl": { "$type": "dimension", "$value": 34 },
      "pill": { "$type": "dimension", "$value": 999 }
    },
    "spacing": {
      "xs": { "$type": "dimension", "$value": 4 },
      "sm": { "$type": "dimension", "$value": 8 },
      "md": { "$type": "dimension", "$value": 12 },
      "lg": { "$type": "dimension", "$value": 16 },
      "xl": { "$type": "dimension", "$value": 24 },
      "xxl": { "$type": "dimension", "$value": 32 },
      "sectionY": { "$type": "dimension", "$value": 72 }
    }
  },
  "n1": {
    "color": {
      "textPrimary": { "$type": "color", "$value": "{n0.color.ink}" },
      "textSecondary": { "$type": "color", "$value": "{n0.color.inkSoft}" },
      "textInverse": { "$type": "color", "$value": "{n0.color.cream}" },
      "accent": { "$type": "color", "$value": "{n0.color.warm}" },
      "accentStrong": { "$type": "color", "$value": "{n0.color.warmAlt}" },
      "surfaceBase": { "$type": "color", "$value": "{n0.color.paper}" },
      "surfaceElevated": { "$type": "color", "$value": "{n0.color.whiteGlass}" },
      "surfaceInverse": { "$type": "color", "$value": "{n0.color.cacao}" },
      "lineSubtle": { "$type": "color", "$value": "{n0.color.line}" }
    },
    "motion": {
      "sectionTransition": { "$type": "duration", "$value": 0.35 },
      "microInteraction": { "$type": "duration", "$value": 0.2 }
    }
  },
  "n2": {
    "component": {
      "card": {
        "$type": "object",
        "$value": {
          "background": "{n1.color.surfaceElevated}",
          "border": "1px solid {n1.color.lineSubtle}",
          "shadow": "{n0.shadow.soft}",
          "radius": "{n0.radius.lg}"
        }
      },
      "badge": {
        "$type": "object",
        "$value": {
          "background": "rgba(255,255,255,0.7)",
          "text": "{n1.color.accent}",
          "radius": "{n0.radius.pill}"
        }
      },
      "hero": {
        "$type": "object",
        "$value": {
          "background": "linear-gradient(180deg, {n0.color.paper} 0%, {n0.color.paperAlt} 100%)",
          "titleFont": "{n0.font.display}",
          "bodyFont": "{n0.font.editorial}"
        }
      }
    }
  },
  "n3": {
    "pattern": {
      "issueLayout": { "$type": "string", "$value": "editorial-split" },
      "communityLayout": { "$type": "string", "$value": "dual-pane-form-feed" },
      "resourceLayout": { "$type": "string", "$value": "immersive-library-grid" }
    }
  },
  "n4": {
    "platform": {
      "web": {
        "$type": "object",
        "$value": {
          "supportsGlass": true,
          "fontSmoothing": "antialiased",
          "stickyNavHeight": 56
        }
      },
      "ios": {
        "$type": "object",
        "$value": {
          "minimumOS": "18.0",
          "tabBarStyle": "liquid-glass",
          "cardMaterial": "thinMaterial"
        }
      }
    },
    "density": {
      "comfortable": { "$type": "number", "$value": 1.0 },
      "compact": { "$type": "number", "$value": 0.92 }
    },
    "a11y": {
      "reducedMotion": {
        "$type": "object",
        "$value": {
          "disableParallax": true,
          "disableProgressAnimation": true
        }
      }
    }
  }
}
